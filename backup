<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RBX Store | Robux e Itens Roblox</title>
    <!-- Fontes e ícones -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <!-- CSS principal -->
    <link rel="stylesheet" href="css/style.css">
</head>

<body>
    <!-- Overlay de digitalização (scan) -->
    <div class="scan-overlay"></div>

    <!-- Fundo com elementos gráficos (blur) -->
    <div class="bg-blur">
        <div class="blur-circle circle-1"></div>
        <div class="blur-circle circle-2"></div>
        <div class="blur-circle circle-3"></div>
    </div>

    <!-- Cabeçalho -->
    <header class="glass-header animate-fade-down">
        <div class="container header-container">
            <div class="logo">
                <i class="fas fa-cube"></i> RBX<span>Store</span>
            </div>
            <nav class="nav-menu">
                <ul>
                    <li><a href="inicio.html">Início</a></li>
                    <li><a href="robux.html">Robux</a></li>
                    <li><a href="itens.html" class="active">Itens</a></li>
                    <li><a href="atendimento.html">Atendimento</a></li>
                </ul>
            </nav>
            <div class="header-actions">
                <a href="#" class="btn-outline"><i class="fas fa-user"></i> Entrar</a>
                <a href="#" class="btn-primary"><i class="fas fa-shopping-cart"></i> Carrinho</a>
            </div>
            <button class="mobile-toggle" id="mobileToggle"><i class="fas fa-bars"></i></button>
        </div>
    </header>

    <main>
        <!-- Hero Section -->
        <section id="inicio" class="hero">
            <div class="container hero-container">
                <div class="hero-content glass-card animate-scale" style="animation-delay: 0.2s;">
                    <h1>Compre Robux e Itens <span class="highlight">Roblox</span> com Segurança</h1>
                    <p>Entrega instantânea, preços competitivos e suporte 24/7. Aumente sua experiência no Roblox agora!
                    </p>
                    <div class="hero-buttons">
                        <a href="#calculadora" class="btn-primary btn-large"><i class="fas fa-calculator"></i> Calcular
                            Robux</a>
                        <a href="#itens" class="btn-outline btn-large"><i class="fas fa-gift"></i> Ver Itens</a>
                    </div>
                </div>
                <div class="hero-stats glass-card animate-scale" style="animation-delay: 0.4s;">
                    <div class="stat-item">
                        <span class="stat-value" id="usersOnline">128</span>
                        <span class="stat-label">Usuários online</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value">15k+</span>
                        <span class="stat-label">Vendas realizadas</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value">4.9</span>
                        <span class="stat-label"><i class="fas fa-star"></i> Avaliações</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Calculadora de Robux (Interativa) -->
        <section id="calculadora" class="calculator-section">
            <div class="container">
                <div class="section-header animate-fade-up" style="animation-delay: 0.6s;">
                    <h2>Calculadora de <span class="highlight">Robux</span></h2>
                    <p>Arraste o controle para escolher a quantidade e veja o preço</p>
                </div>
                <div class="calculator-card glass-card animate-scale" style="animation-delay: 0.8s;">
                    <div class="calculator-display">
                        <div class="robux-amount">
                            <span id="robuxValue">1000</span> Robux
                        </div>
                        <div class="price-display">
                            <span id="priceValue">$19.90</span>
                        </div>
                    </div>
                    <div class="slider-container">
                        <input type="range" id="robuxSlider" min="100" max="5000" step="100" value="1000">
                        <div class="slider-labels">
                            <span>100</span>
                            <span>2500</span>
                            <span>5000</span>
                        </div>
                    </div>
                    <div class="quick-options">
                        <button class="quick-btn" data-robux="400">400</button>
                        <button class="quick-btn" data-robux="800">800</button>
                        <button class="quick-btn" data-robux="1200">1200</button>
                        <button class="quick-btn" data-robux="2000">2000</button>
                    </div>
                    <a href="#" class="btn-primary btn-block"><i class="fas fa-bolt"></i> Comprar agora</a>
                    <p class="small-note"><i class="fas fa-shield-alt"></i> Pagamento 100% seguro e entrega automática
                    </p>
                </div>
            </div>
        </section>

        <!-- Itens em destaque -->
        <section id="itens" class="items-section">
            <div class="container">
                <div class="section-header animate-fade-up" style="animation-delay: 1s;">
                    <h2><span class="highlight">Destaques</span></h2>
                    <p>Os melhores itens para turbinar seu avatar</p>
                </div>
                <div class="items-grid">
                    <!-- Item 1 -->
                    <div class="item-card glass-card animate-scale" style="animation-delay: 1.1s;">
                        <div class="item-icon"><i class="fas fa-hat-wizard"></i></div>
                        <h3>Chapeu Mágico</h3>
                        <p>Raro • Edição limitada</p>
                        <div class="item-price">R$ 14,90</div>
                        <a href="#" class="btn-outline btn-small"><i class="fas fa-shopping-bag"></i> Comprar</a>
                    </div>
                    <!-- Item 2 -->
                    <div class="item-card glass-card animate-scale" style="animation-delay: 1.2s;">
                        <div class="item-icon"><i class="fas fa-dragon"></i></div>
                        <h3>Asas de Dragão</h3>
                        <p>Épico • 1k vendidos</p>
                        <div class="item-price">R$ 29,90</div>
                        <a href="#" class="btn-outline btn-small"><i class="fas fa-shopping-bag"></i> Comprar</a>
                    </div>
                    <!-- Item 3 -->
                    <div class="item-card glass-card animate-scale" style="animation-delay: 1.3s;">
                        <div class="item-icon"><i class="fas fa-robot"></i></div>
                        <h3>Mochila Tecnológica</h3>
                        <p>Lendário • Novo</p>
                        <div class="item-price">R$ 49,90</div>
                        <a href="#" class="btn-outline btn-small"><i class="fas fa-shopping-bag"></i> Comprar</a>
                    </div>
                    <!-- Item 4 -->
                    <div class="item-card glass-card animate-scale" style="animation-delay: 1.4s;">
                        <div class="item-icon"><i class="fas fa-gamepad"></i></div>
                        <h3>Gamepass Pro</h3>
                        <p>Vantagens exclusivas</p>
                        <div class="item-price">R$ 34,90</div>
                        <a href="#" class="btn-outline btn-small"><i class="fas fa-shopping-bag"></i> Comprar</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Chamada para ação final -->
        <section class="cta-section">
            <div class="container">
                <div class="cta-card glass-card animate-scale" style="animation-delay: 1.6s;">
                    <h2>Pronto para turbinar sua conta?</h2>
                    <p>Milhares de jogadores já confiam na RBX Store.</p>
                    <a href="#" class="btn-primary btn-large"><i class="fas fa-rocket"></i> Começar agora</a>
                </div>
            </div>
        </section>
    </main>

    <!-- Rodapé -->
    <footer class="glass-footer animate-fade-up" style="animation-delay: 1.8s;">
        <div class="container footer-container">
            <div class="footer-col">
                <div class="logo"><i class="fas fa-cube"></i> RBX<span>Store</span></div>
                <p>O lugar mais seguro para comprar Robux e itens Roblox.</p>
                <div class="social-icons">
                    <a href="#"><i class="fab fa-discord"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>
            <div class="footer-col">
                <h4>Links Rápidos</h4>
                <ul>
                    <li><a href="#inicio">Início</a></li>
                    <li><a href="#calculadora">Robux</a></li>
                    <li><a href="#itens">Itens</a></li>
                    <li><a href="#">Suporte</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Legal</h4>
                <ul>
                    <li><a href="#">Termos de Uso</a></li>
                    <li><a href="privacidade.html">Política de Privacidade</a></li>
                    <li><a href="#">Reembolsos</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Contato</h4>
                <ul>
                    <li><i class="fas fa-envelope"></i> suporte@rbxstore.com</li>
                    <li><i class="fas fa-clock"></i> 24/7 Online</li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; 2025 RBX Store. Todos os direitos reservados. Este site não é afiliado ao Roblox.</p>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="js/script.js"></script>
</body>

</html>